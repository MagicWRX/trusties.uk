{
  "name": "@magicwrxtools/block-system",
  "version": "0.1.0",
  "description": "Universal block container system \u2014 the execution layer between LayoutContract regions and leaf content",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/fetchBlocks.d.ts",
      "default": "./dist/server/fetchBlocks.js"
    },
    "./types": {
      "types": "./dist/types/exports.d.ts",
      "default": "./dist/types/exports.js"
    }
  },
  "typesVersions": {
    "*": {
      "server": [
        "dist/server/fetchBlocks.d.ts"
      ],
      "types": [
        "dist/types/exports.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc -w",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "peerDependencies": {
    "next": "^14.0.0 || ^15.0.0 || ^16.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicWRXTools/shared.git",
    "directory": "block-system"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}